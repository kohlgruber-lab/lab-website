---
import site from '../data/site-settings.json';
---
<footer class="border-t border-slate-200 bg-white">
  <div class="section py-8 text-sm">
    <p class="font-semibold text-slate-900">{site.lab_name}</p>
    <p>{site.address}</p>
    <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    <p class="mt-3 text-slate-600">© {new Date().getFullYear()} {site.lab_name}. All rights reserved.</p>
  </div>
</footer>
