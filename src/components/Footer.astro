---
import site from '../data/site-settings.json';
---
<footer class="border-t border-slate-200 bg-white">
  <div class="section py-10 text-sm">
    <p class="text-base font-semibold text-brand-ink">{site.lab_name}</p>
    <p class="mt-1 text-slate-700">{site.address}</p>
    <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    <div class="mt-4 flex flex-wrap gap-4">
      {site.socials.map((social) => (
        <a href={social.url} class="text-slate-600 hover:text-brand-turquoise">{social.label}</a>
      ))}
    </div>
    <p class="mt-5 text-slate-500">© {new Date().getFullYear()} {site.lab_name}. All rights reserved.</p>
  </div>
</footer>
