---
import site from '../data/site-settings.json';

const links = [
  ['Welcome', '/'],
  ['Research', '/research'],
  ['Team', '/team'],
  ['News', '/news'],
  ['Culture', '/culture'],
  ['Contact', '/contact'],
];
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-30 border-b border-brand-gray/20 bg-brand-offwhite">
  <div class="h-1 w-full bg-gradient-to-r from-brand-turquoise via-brand-turquoise to-brand-orange"></div>

  <nav class="mx-auto flex max-w-7xl items-center px-4 py-3 sm:px-6 lg:px-8" aria-label="Primary">
    <!-- Logo + Lab Name -->
    <a href="/" class="flex shrink-0 items-center gap-2 no-underline mr-8">
      {site.lab_logo && (
        <img
          src={site.lab_logo}
          alt={`${site.lab_name} logo`}
          class="h-16 w-auto object-contain sm:h-20"
          style="mix-blend-mode: multiply;"
        />
      )}
      <div class="flex flex-col" style="line-height: 1.05;">
        <span style="color: #06948E; font-family: 'Avenir Next Condensed', 'Avenir Next', 'Barlow Condensed', sans-serif; font-size: 1.75rem; font-weight: 500; letter-spacing: -0.01em;"><span style="font-size: 2.1rem; font-weight: 600;">K</span>ohlgruber</span>
        <span style="color: #707071; font-family: 'Avenir Next Condensed', 'Avenir Next', 'Barlow Condensed', sans-serif; font-size: 1.75rem; font-weight: 500; letter-spacing: -0.01em;"><span style="font-size: 2.1rem; font-weight: 600;">L</span>ab</span>
      </div>
    </a>

    <!-- Desktop nav links — evenly spaced across remaining width -->
    <ul class="hidden lg:flex flex-1 items-center justify-evenly">
      {links.map(([label, href]) => (
        <li>
          <a
            href={href}
            class:list={[
              'whitespace-nowrap px-1 py-1 text-sm font-semibold transition-colors sm:text-base',
              current === href
                ? 'text-brand-turquoise border-b-2 border-brand-turquoise'
                : 'text-brand-ink hover:text-brand-turquoise'
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger button -->
    <button
      id="nav-toggle"
      class="ml-auto lg:hidden flex items-center justify-center rounded-md p-2 text-brand-ink hover:text-brand-turquoise transition-colors"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="nav-dropdown"
    >
      <!-- Hamburger icon -->
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <!-- Close (X) icon — hidden by default -->
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile dropdown menu -->
  <div
    id="nav-dropdown"
    class="hidden lg:hidden border-t border-brand-gray/20 bg-brand-offwhite"
  >
    <ul class="flex flex-col px-4 py-2">
      {links.map(([label, href]) => (
        <li>
          <a
            href={href}
            class:list={[
              'block px-3 py-3 text-base font-semibold transition-colors border-b border-brand-gray/10 last:border-0',
              current === href
                ? 'text-brand-turquoise'
                : 'text-brand-ink hover:text-brand-turquoise'
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const dropdown = document.getElementById('nav-dropdown');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !dropdown?.classList.contains('hidden');
    dropdown?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isOpen ? true : false);
    iconClose?.classList.toggle('hidden', !isOpen ? false : true);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close menu when a link is tapped
  dropdown?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      dropdown.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
