---
const links = [
  ['Home', '/'],
  ['Research', '/research'],
  ['Team', '/team'],
  ['Mentoring', '/mentoring'],
  ['Lab News', '/news'],
  ['Lab Fun', '/fun'],
  ['Join Us', '/join'],
  ['Contact', '/contact']
];
const current = Astro.url.pathname;
---
<header class="border-b border-slate-200 bg-white/95 sticky top-0 z-20 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
    <a href="/" class="text-lg font-semibold text-slate-900">Kohlgruber Lab</a>
    <ul class="flex flex-wrap gap-2 text-sm font-medium">
      {links.map(([label, href]) => (
        <li>
          <a href={href} class:list={["rounded-md px-3 py-2", current === href ? 'bg-primary-50 text-primary-700' : 'text-slate-700 hover:bg-slate-100']}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
