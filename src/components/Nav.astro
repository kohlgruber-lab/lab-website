---
const links = [
  ['Welcome', '/'],
  ['Research', '/research'],
  ['Team', '/team'],
  ['News', '/news'],
  ['Culture', '/culture'],
  ['Contact', '/contact'],
  ['Join Us', '/join']
];
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-30 border-b border-brand-gray/30 bg-brand-offwhite/95 backdrop-blur">
  <div class="h-1 w-full bg-gradient-to-r from-brand-turquoise via-brand-turquoise to-brand-orange"></div>
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
    <a href="/" class="text-lg font-semibold tracking-tight text-brand-ink">Kohlgruber Lab</a>
    <ul class="flex flex-wrap items-center gap-1 text-sm font-medium">
      {links.map(([label, href]) => (
        <li>
          <a
            href={href}
            class:list={[
              'rounded-full px-3 py-2 transition-colors',
              current === href
                ? 'bg-brand-turquoise text-white'
                : 'text-brand-ink hover:bg-white hover:text-brand-turquoise'
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
