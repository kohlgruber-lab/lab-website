---
import site from '../data/site-settings.json';

const links = [
  ['Welcome', '/'],
  ['Research', '/research'],
  ['Team', '/team'],
  ['News', '/news'],
  ['Culture', '/culture'],
  ['Contact', '/contact'],
];
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-30 border-b border-brand-gray/20 bg-brand-offwhite/95 backdrop-blur">
  <div class="h-1 w-full bg-gradient-to-r from-brand-turquoise via-brand-turquoise to-brand-orange"></div>

  <nav class="mx-auto flex max-w-7xl items-center px-4 py-3 sm:px-6 lg:px-8" aria-label="Primary">
    <!-- Logo + Lab Name -->
    <a href="/" class="flex shrink-0 items-center gap-2 no-underline mr-8">
      {site.lab_logo && (
        <img
          src={site.lab_logo}
          alt={`${site.lab_name} logo`}
          class="h-16 w-auto object-contain sm:h-20"
          style="mix-blend-mode: multiply;"
        />
      )}
      <div class="flex flex-col leading-tight">
        <span class="text-xl font-bold tracking-tight sm:text-2xl" style="color: #06948E;">Kohlgruber</span>
        <span class="text-xl font-bold tracking-tight sm:text-2xl" style="color: #707071;">Lab</span>
      </div>
    </a>

    <!-- Nav links — evenly spaced across remaining width -->
    <ul class="flex flex-1 items-center justify-evenly">
      {links.map(([label, href]) => (
        <li>
          <a
            href={href}
            class:list={[
              'whitespace-nowrap px-1 py-1 text-sm font-semibold transition-colors sm:text-base',
              current === href
                ? 'text-brand-turquoise border-b-2 border-brand-turquoise'
                : 'text-brand-ink hover:text-brand-turquoise'
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
