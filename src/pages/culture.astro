---
import BaseLayout from '../layouts/BaseLayout.astro';
import culturePage from '../data/culture-page.json';

const sections = [
  {
    title: culturePage.culture_title ?? 'Culture',
    text: culturePage.culture_text,
    accent: 'var(--color-primary)',
    icon: '🤝',
  },
  {
    title: culturePage.philosophy_title ?? 'Philosophy',
    text: culturePage.philosophy_text,
    accent: 'var(--color-accent)',
    icon: '📜',
  },
  {
    title: culturePage.mentoring_title ?? 'Mentoring',
    text: culturePage.mentoring_text,
    accent: 'var(--color-navy)',
    icon: '🌱',
  },
];

const allPhotos = culturePage.photo_collage ?? [];
const sidebarPhotos = allPhotos.filter((p: any) => p.sidebar);
const collagPhotos  = allPhotos.filter((p: any) => !p.sidebar);
---

<BaseLayout title={culturePage.title ?? 'Culture'} description="Lab culture, philosophy, and mentoring.">

  <!-- ── Page header ──────────────────────────────────────────── -->
  <div style="background: linear-gradient(105deg, var(--color-navy) 0%, var(--color-primary) 100%);">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-white">{culturePage.title ?? 'Culture'}</h1>
      {culturePage.intro && (
        <p class="mt-3 max-w-2xl text-lg leading-tight" style="color: rgba(255,255,255,0.82);">
          {culturePage.intro}
        </p>
      )}
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">

    <!-- ── Side-by-side: text left, selected sidebar photos right ── -->
    <div class="lg:grid lg:gap-16 lg:items-start" style="grid-template-columns: 1fr 40%;">

      <!-- LEFT: text sections -->
      <div class="space-y-12 mb-12 lg:mb-0">
        {sections.map((sec) => (
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="h-8 w-1.5 rounded-full shrink-0" style={`background-color: ${sec.accent};`}></div>
              <h2 class="text-2xl font-bold tracking-tight flex items-center gap-2" style={`color: ${sec.accent};`}>
                {sec.title}
                <span class="text-2xl" role="img" aria-label={sec.title}>{sec.icon}</span>
              </h2>
            </div>
            <p class="leading-6 text-brand-gray text-base">{sec.text}</p>
          </div>
        ))}
      </div>

      <!-- RIGHT: sidebar photos stacked at natural aspect ratio -->
      {sidebarPhotos.length > 0 && (
        <div class="hidden lg:flex flex-col gap-3">
          <p class="text-sm font-bold uppercase tracking-widest mb-1" style="color: var(--color-primary);">
            Life in and out of the lab
          </p>
          {sidebarPhotos.map((photo: any) => (
            <div class="rounded-xl overflow-hidden shadow-soft" style="border: 1px solid var(--color-border);">
              <img
                src={photo.image}
                alt={photo.alt ?? 'Lab photo'}
                loading="eager"
                class="w-full h-auto block"
              />
            </div>
          ))}
        </div>
      )}

    </div>

    <!-- ── Full-width masonry collage: all non-sidebar photos ── -->
    {collagPhotos.length > 0 && (
      <div class="mt-16">
        {sidebarPhotos.length === 0 && (
          <p class="text-sm font-bold uppercase tracking-widest mb-6" style="color: var(--color-primary);">
            Life in and out of the lab
          </p>
        )}
        <div class="culture-collage">
          {collagPhotos.map((photo: any) => (
            <div class="culture-collage-item">
              <img
                src={photo.image}
                alt={photo.alt ?? 'Lab photo'}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    )}

  </div>

</BaseLayout>
