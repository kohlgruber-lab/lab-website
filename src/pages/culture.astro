---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('culture')).sort((a, b) => {
  if (!a.data.date || !b.data.date) return 0;
  return b.data.date.getTime() - a.data.date.getTime();
});
---
<BaseLayout title="Culture" description="Lab values, traditions, and moments beyond the bench.">
  <section class="section">
    <h1 class="text-4xl font-semibold tracking-tight">Culture</h1>
    <p class="mt-3 max-w-3xl text-slate-700">We care deeply about mentorship, team rituals, scientific joy, and building a healthy environment where everyone can do their best work.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <article class="card p-4">
          {item.data.image && <img src={item.data.image} alt={item.data.title} loading="lazy" class="h-40 w-full rounded-xl object-cover" />}
          <p class="mt-3"><span class="badge-accent">{item.data.type}</span></p>
          <h2 class="mt-2 text-lg font-semibold">{item.data.title}</h2>
          <p class="mt-2 text-sm text-slate-700">{item.data.summary}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
