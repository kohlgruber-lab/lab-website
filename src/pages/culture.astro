---
import BaseLayout from '../layouts/BaseLayout.astro';
import culturePage from '../data/culture-page.json';

const sections = [
  {
    title: culturePage.culture_title ?? 'Culture',
    text: culturePage.culture_text,
    accent: 'var(--color-primary)',
    icon: '🤝',
  },
  {
    title: culturePage.philosophy_title ?? 'Philosophy',
    text: culturePage.philosophy_text,
    accent: 'var(--color-accent)',
    icon: '📜',
  },
  {
    title: culturePage.mentoring_title ?? 'Mentoring',
    text: culturePage.mentoring_text,
    accent: 'var(--color-navy)',
    icon: '🌱',
  },
];
---

<BaseLayout title={culturePage.title ?? 'Culture'} description="Lab culture, philosophy, and mentoring.">

  <!-- Hero banner -->
  <div style="background: linear-gradient(105deg, var(--color-navy) 0%, var(--color-primary) 100%);" class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        {culturePage.title ?? 'Culture'}
      </h1>
      {culturePage.intro && (
        <p class="mt-4 max-w-2xl text-lg leading-relaxed" style="color: rgba(255,255,255,0.82);">
          {culturePage.intro}
        </p>
      )}
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">

    <!-- Text sections -->
    <div class="space-y-12 max-w-3xl">
      {sections.map((sec) => (
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="h-8 w-1.5 rounded-full shrink-0" style={`background-color: ${sec.accent};`}></div>
            <h2 class="text-2xl font-bold tracking-tight flex items-center gap-2" style={`color: ${sec.accent};`}>
              {sec.title}
              <span class="text-2xl" role="img" aria-label={sec.title}>{sec.icon}</span>
            </h2>
          </div>
          <p class="leading-6 text-brand-gray text-base">{sec.text}</p>
        </div>
      ))}
    </div>

    <!-- Photo collage — always below the text sections, natural aspect ratios via CSS columns masonry -->
    {culturePage.photo_collage && culturePage.photo_collage.length > 0 && (
      <div class="mt-16">
        <h2 class="mb-6 text-sm font-bold uppercase tracking-widest" style="color: var(--color-primary);">
          Life in and out of the lab
        </h2>
        <div class="culture-collage">
          {culturePage.photo_collage.map((photo) => (
            <div class="culture-collage-item">
              <img
                src={photo.image}
                alt={photo.alt ?? 'Lab photo'}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    )}

  </div>

</BaseLayout>
