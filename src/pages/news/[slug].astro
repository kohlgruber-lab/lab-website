---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({ params: { slug: post.id.replace('.md', '') }, props: { post } }));
}

const { post } = Astro.props;
---
<BaseLayout title={post.data.title} description={post.data.title}>
  <article class="section max-w-3xl">
    <p class="text-sm text-slate-500">{post.data.date.toISOString().slice(0,10)}</p>
    <h1 class="mt-2 text-3xl font-bold text-brand-ink">{post.data.title}</h1>
    {post.data.featured_image && (
      <img src={post.data.featured_image} alt={post.data.title} class="mt-6 w-full rounded-2xl" loading="lazy" />
    )}
  </article>
</BaseLayout>
