---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const groupedPosts = posts.reduce((acc: Record<string, typeof posts>, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

// Years sorted newest-first; only the 3 most recent stay open
const sortedYears = Object.keys(groupedPosts).sort((a, b) => Number(b) - Number(a));
const recentYears = new Set(sortedYears.slice(0, 3));
---

<BaseLayout title="News" description="Updates from the Kohlgruber Lab.">
  <section class="section">
    <h1 class="text-4xl font-semibold tracking-tight text-brand-ink">News</h1>
    <p class="mt-3 max-w-3xl text-brand-gray">
      Updates from the lab, including research highlights, papers, presentations, awards, and team news.
    </p>

    <div class="mt-10 space-y-10">
      {sortedYears.map((year) => {
        const yearPosts = groupedPosts[year];
        const isRecent = recentYears.has(year);

        const header = (
          <div class="flex items-center gap-4">
            <span
              class="rounded-full px-4 py-1 text-sm font-bold tracking-wider text-white shrink-0"
              style="background-color: var(--color-primary);"
            >
              {year}
            </span>
            <div class="flex-1 h-px" style="background-color: var(--color-border);"></div>
          </div>
        );

        const postList = (
          <div class="mt-4 space-y-0 divide-y" style="border-color: var(--color-border);">
            {yearPosts.map((post) => (
              <article class="news-item group flex gap-4 py-5 md:gap-6">

                <!-- Accent stripe -->
                <div
                  class="news-item-stripe shrink-0 w-1 rounded-full"
                  style="background-color: var(--color-accent);"
                ></div>

                <!-- Optional thumbnail -->
                {post.data.featured_image && (
                  <div class="hidden shrink-0 md:block">
                    <img
                      src={post.data.featured_image}
                      alt={post.data.title}
                      loading="lazy"
                      class="h-24 w-36 rounded-xl object-cover"
                    />
                  </div>
                )}

                <!-- Content -->
                <div class="min-w-0 flex-1">
                  <p
                    class="mb-1 text-xs font-bold uppercase tracking-widest"
                    style="color: var(--color-primary);"
                  >
                    {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                  </p>

                  <h3 class="text-lg font-semibold text-brand-ink leading-snug">
                    {post.data.title}
                  </h3>

                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="mt-2.5 flex flex-wrap gap-1.5">
                      {post.data.tags.map((tag) => (
                        <span
                          class="rounded-full px-2.5 py-0.5 text-xs font-medium"
                          style="background-color: rgba(6,148,142,0.1); color: var(--color-primary);"
                        >
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>

              </article>
            ))}
          </div>
        );

        return isRecent ? (
          <section>
            {header}
            {postList}
          </section>
        ) : (
          <details class="group/year">
            <summary class="flex cursor-pointer list-none items-center gap-4 marker:hidden [&::-webkit-details-marker]:hidden">
              <span
                class="rounded-full px-4 py-1 text-sm font-bold tracking-wider shrink-0"
                style="background-color: var(--color-soft-surface); color: var(--color-primary); border: 1px solid var(--color-border);"
              >
                {year}
              </span>
              <div class="flex-1 h-px" style="background-color: var(--color-border);"></div>
              <span class="text-xs shrink-0" style="color: var(--color-primary);">
                {yearPosts.length} {yearPosts.length === 1 ? 'item' : 'items'} — click to expand
              </span>
            </summary>
            {postList}
          </details>
        );
      })}
    </div>
  </section>
</BaseLayout>
