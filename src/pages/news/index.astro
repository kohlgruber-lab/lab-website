---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="News" description="Updates from the Kohlgruber Lab.">
  <section class="section">
    <h1 class="text-4xl font-semibold tracking-tight">News</h1>
    <div class="mt-8 space-y-4">
      {posts.map((post) => (
        <article class="card">
          <p class="text-sm text-slate-500">{post.data.date.toISOString().slice(0, 10)}</p>
          <h2 class="text-xl font-semibold"><a href={`/news/${post.id.replace('.md', '')}`}>{post.data.title}</a></h2>
          <p class="mt-2 text-slate-700">{post.data.summary}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
