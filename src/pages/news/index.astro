---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const groupedPosts = posts.reduce((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});
---

<BaseLayout title="News" description="Updates from the Kohlgruber Lab.">
  <section class="section">
    <h1 class="text-4xl font-semibold tracking-tight text-brand-ink">News</h1>
    <p class="mt-3 max-w-3xl text-brand-gray">
      Updates from the lab, including research highlights, papers, presentations, awards, and team news.
    </p>

    <div class="mt-10 space-y-12">
      {Object.entries(groupedPosts).map(([year, yearPosts]) => (
        <section>
          <h2 class="text-2xl font-semibold tracking-tight text-brand-ink">{year}</h2>

          <div class="mt-6 space-y-5">
            {yearPosts.map((post) => (
              <article class="card p-5">
                <div class="flex flex-col gap-5 md:flex-row md:items-start">
                  {post.data.featured_image && (
                    <a
                      href={`/news/${post.id.replace('.md', '')}`}
                      class="block shrink-0"
                    >
                      <img
                        src={post.data.featured_image}
                        alt={post.data.title}
                        loading="lazy"
                        class="h-40 w-full rounded-xl object-cover md:w-64"
                      />
                    </a>
                  )}

                  <div class="min-w-0 flex-1">
                    <p class="text-sm text-brand-gray">
                      {post.data.date.toISOString().slice(0, 10)}
                    </p>

                    <h3 class="mt-1 text-xl font-semibold text-brand-ink">
                      <a
                        href={`/news/${post.id.replace('.md', '')}`}
                        class="transition-colors hover:text-brand-primary"
                      >
                        {post.data.title}
                      </a>
                    </h3>

                    <p class="mt-3 leading-7 text-brand-gray">
                      {post.data.summary}
                    </p>

                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-2">
                        {post.data.tags.map((tag) => (
                          <span class="rounded-full bg-brand-offwhite px-3 py-1 text-xs font-medium text-brand-gray">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
