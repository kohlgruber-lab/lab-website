---
import BaseLayout from '../layouts/BaseLayout.astro';
import research from '../data/research-page.json';

// Accent colors cycling through brand palette (area 1 = orange, area 2 = teal, area 3 = navy)
const accents = [
  { color: 'var(--color-accent)',  bg: '#fdf8f3', borderColor: 'var(--color-accent)'  },
  { color: 'var(--color-primary)', bg: '#f0f9f8', borderColor: 'var(--color-primary)' },
  { color: 'var(--color-navy)',    bg: '#eef1f5', borderColor: 'var(--color-navy)'    },
];

function renderParagraphs(text: string): string[] {
  return text.split(/\n\n+/).map(p => p.trim()).filter(Boolean);
}
---
<BaseLayout title="Research" description="Three core research themes in translational immunology.">

  <!-- ── Page header ──────────────────────────────────────────── -->
  <div style="background: linear-gradient(105deg, var(--color-navy) 0%, var(--color-primary) 100%);">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-white">Research</h1>
      <p class="mt-3 max-w-2xl text-lg leading-tight" style="color: rgba(255,255,255,0.82);">{research.intro}</p>
    </div>
  </div>

  <!-- ── Research Themes ─────────────────────────────────────── -->
  {research.themes.map((theme, i) => {
    const accent = accents[i % accents.length];
    const isEven = i % 2 === 0;
    const paragraphs = renderParagraphs(theme.text);
    return (
      <section
        class="research-theme-section"
        style={`background-color: ${accent.bg};`}
      >
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
          <div class:list={['flex flex-col gap-10 lg:flex-row lg:items-center lg:gap-16', !isEven && 'lg:flex-row-reverse']}>

            <!-- Visual side -->
            <div class="lg:w-5/12 shrink-0">
              <div class="overflow-hidden rounded-2xl shadow-md" style={`border: 2px solid ${accent.borderColor}22;`}>
                {(theme as any).image ? (
                  <img
                    src={(theme as any).image}
                    alt={`Visual for ${theme.title}`}
                    class="w-full h-auto block"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class="flex items-center justify-center"
                    style={`aspect-ratio: 4/3; background: linear-gradient(135deg, ${accent.color}18, ${accent.color}06);`}
                  >
                    <span class="text-5xl font-bold" style={`color: ${accent.color}; opacity: 0.18;`}>
                      {i + 1}
                    </span>
                  </div>
                )}
              </div>
            </div>

            <!-- Text side -->
            <div class="flex-1 min-w-0">
              <div class="mb-4 flex items-center gap-3">
                <div class="h-1 w-8 rounded-full shrink-0" style={`background-color: ${accent.color};`}></div>
                <span class="text-xs font-bold uppercase tracking-widest" style={`color: ${accent.color};`}>
                  Research Area {i + 1}
                </span>
              </div>
              <h2 class="text-xl font-bold tracking-tight text-brand-ink sm:text-2xl">
                {theme.title}
              </h2>
              <div class="mt-5 space-y-4">
                {paragraphs.map(p => (
                  <p class="leading-6 text-brand-gray text-base">{p}</p>
                ))}
              </div>
            </div>

          </div>
        </div>
      </section>
    );
  })}

</BaseLayout>
