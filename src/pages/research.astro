---
import BaseLayout from '../layouts/BaseLayout.astro';
import research from '../data/research.json';
---
<BaseLayout title="Research" description="Research themes in translational immunology.">
  <section class="section">
    <h1 class="text-3xl font-bold">Research</h1>
    <svg viewBox="0 0 900 80" class="mt-6 w-full" role="img" aria-label="Research pipeline">
      <text x="20" y="45">Antigen discovery</text><text x="200" y="45">→</text>
      <text x="240" y="45">Ligand mapping</text><text x="390" y="45">→</text>
      <text x="430" y="45">TCR discovery</text><text x="560" y="45">→</text>
      <text x="600" y="45">Engineering</text><text x="710" y="45">→</text>
      <text x="740" y="45">Translation</text>
    </svg>
    <div class="mt-8 space-y-6">
      {research.themes.map((theme) => <article class="card"><h2 class="text-xl font-semibold">{theme.title}</h2><p class="mt-3">{theme.text}</p></article>)}
    </div>
  </section>
</BaseLayout>
