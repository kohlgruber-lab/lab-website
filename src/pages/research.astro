---
import BaseLayout from '../layouts/BaseLayout.astro';
import research from '../data/research-page.json';
---
<BaseLayout title="Research" description="Three core research themes in translational immunology.">
  <section class="section">
    <h1 class="text-4xl font-semibold tracking-tight text-brand-ink">Research</h1>
    <p class="mt-3 max-w-3xl text-brand-gray">{research.intro}</p>

    <div class="mt-8 space-y-5">
      {research.themes.map((theme) => (
        <article class="card">
          <h2 class="text-2xl font-semibold text-brand-ink">{theme.title}</h2>
          <p class="mt-3 leading-7 text-brand-gray">{theme.text}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
