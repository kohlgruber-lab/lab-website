---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import site from '../data/site-settings.json';
import welcome from '../data/welcome.json';
import research from '../data/research-page.json';

const team = (await getCollection('team'))
  .filter((m) => m.data.featured_on_home)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const labPhoto = (welcome as any).lab_photo as string | undefined;

// Accent colors per research card (cycling)
const cardAccents = ['var(--color-accent)', 'var(--color-primary)', 'var(--color-navy)'];
---
<BaseLayout title="Welcome" description={site.mission_statement}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="relative flex items-center overflow-hidden" style="min-height: 520px;">
    {labPhoto ? (
      <>
        <img
          src={labPhoto}
          alt="Kohlgruber Lab"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0" style="background: linear-gradient(105deg, rgba(31,53,82,0.90) 0%, rgba(6,148,142,0.55) 62%, rgba(6,148,142,0.12) 100%);"></div>
      </>
    ) : (
      <div class="absolute inset-0" style="background: linear-gradient(135deg, #1F3552 0%, #06948E 100%);"></div>
    )}

    <div class="relative z-10 mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em]" style="color: rgba(231,135,43,0.95);">
        {welcome.hero.eyebrow}
      </p>
      <h1 class="max-w-3xl text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-[4.5rem] leading-tight">
        {welcome.hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed" style="color: rgba(255,255,255,0.82);">
        {site.mission_statement}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="/research">Explore Research</a>
        <a
          href="/team"
          class="inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold text-white transition"
          style="background-color: #E7872B; hover:opacity-90;"
          onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'"
        >Meet Our Team</a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-full border px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
          style="border-color: rgba(255,255,255,0.45);"
        >Contact Us</a>
      </div>
    </div>
  </section>


  <!-- ── News ─────────────────────────────────────────────────── -->
  {news.length > 0 && (
    <section class="section pt-0">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="h2">Latest News</h2>
        <a href="/news" class="text-sm font-semibold text-brand-ink hover:text-brand-turquoise">
          All news →
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {news.map((post) => (
          <article class="soft-card p-5">
            <p class="text-xs text-brand-gray">{post.data.date.toISOString().slice(0, 10)}</p>
            <h3 class="mt-2 text-base font-semibold text-brand-ink">
              <a href={`/news/${post.id.replace('.md', '')}`} class="hover:text-brand-turquoise">
                {post.data.title}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-6 text-brand-gray">{post.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- ── Affiliations ─────────────────────────────────────────── -->
  <section class="section pt-0">
    <div class="flex flex-wrap items-center justify-center gap-10">
      <a href="https://www.childrenshospital.org" target="_blank" rel="noopener" aria-label="Boston Children's Hospital">
        <img src="/uploads/bch-logo.svg" alt="Boston Children's Hospital" class="h-14 w-auto object-contain" loading="lazy" />
      </a>
      <a href="https://hms.harvard.edu" target="_blank" rel="noopener" aria-label="Harvard Medical School">
        <img src="/uploads/hms-logo.svg" alt="Harvard Medical School" class="h-14 w-auto object-contain" loading="lazy" />
      </a>
      <a href="https://www.broadinstitute.org" target="_blank" rel="noopener" aria-label="Broad Institute of Harvard and MIT">
        <img src="/uploads/broad-logo.svg" alt="Broad Institute of Harvard and MIT" class="h-14 w-auto object-contain" loading="lazy" />
      </a>
    </div>
  </section>

  <!-- ── Funding ───────────────────────────────────────────────── -->
  {site.funding_logos.length > 0 && (
    <section class="section pt-0">
      <p class="mb-8 text-center text-base text-brand-gray">
        We are grateful for the support of our research from the following organizations
      </p>
      <div class="flex flex-wrap items-center justify-center gap-6">
        {site.funding_logos.map((logo) => (
          <a
            href={logo.url ?? '#'}
            class="flex h-20 w-36 items-center justify-center rounded-xl border border-brand-gray/15 bg-white p-3 transition hover:shadow-md"
            aria-label={logo.name}
          >
            <img src={logo.image} alt={logo.alt_text} loading="lazy" class="max-h-14 max-w-full object-contain" />
          </a>
        ))}
      </div>
    </section>
  )}

</BaseLayout>
