---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import site from '../data/site-settings.json';
import { welcomeContent as welcome, researchContent as research } from '../lib/labWebsiteV2';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const culture = (await getCollection('culture')).slice(0, 4);
---
<BaseLayout title="Welcome" description={site.mission_statement}>
  <section class="section pb-10">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-gray">{welcome.hero.eyebrow}</p>
    <h1 class="mt-3 max-w-5xl text-4xl font-semibold tracking-tight text-brand-ink sm:text-5xl">{welcome.hero.title}</h1>
    <article class="mt-6 max-w-5xl rounded-2xl border border-brand-turquoise/30 bg-brand-turquoise/5 p-5 shadow-soft">
      <p class="badge-accent">{welcome.hero.highlight_label ?? 'Lab focus'}</p>
      <p class="mt-3 text-lg text-slate-700">{welcome.hero.description}</p>
    </article>
    <div class="mt-7 flex flex-wrap gap-3">
      <a class="btn-primary" href={welcome.hero.primary_cta.href}>{welcome.hero.primary_cta.label}</a>
      <a class="btn-secondary" href={welcome.hero.secondary_cta.href}>{welcome.hero.secondary_cta.label}</a>
      <a class="btn-secondary" href="/research">Explore Research</a>
    </div>
  </section>

  <section class="section pt-0">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="h2">Research</h2>
      <a href="/research" class="text-sm font-semibold">View full research overview →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {research.themes.map((theme) => (
        <article class="card">
          <h3 class="text-xl font-semibold">{theme.title}</h3>
          <p class="mt-3 text-sm text-slate-700">{theme.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section pt-0">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="h2">Team</h2>
      <a href="/team" class="text-sm font-semibold">Meet everyone →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {team.map((member) => (
        <article class="card p-4">
          <img src={member.data.photo} alt={`Portrait of ${member.data.name}`} class="h-48 w-full rounded-xl object-cover" loading="lazy" />
          <h3 class="mt-3 text-lg font-semibold">{member.data.name}</h3>
          <p class="text-sm text-slate-600">{member.data.position}</p>
          <p class="text-sm">{member.data.nationality_flag_emoji} {member.data.nationality_country}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section pt-0">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="h2">Mentoring & Culture</h2>
      <a href="/culture" class="text-sm font-semibold">Explore culture →</a>
    </div>
    <p class="max-w-3xl text-slate-700">{welcome.culture_preview}</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {culture.map((item) => (
        <article class="card p-4">
          {item.data.image && <img src={item.data.image} alt={item.data.title} class="h-32 w-full rounded-xl object-cover" loading="lazy" />}
          <p class="mt-3"><span class="badge-accent">{item.data.type}</span></p>
          <h3 class="mt-2 font-semibold">{item.data.title}</h3>
        </article>
      ))}
    </div>
  </section>

  <section class="section pt-0">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="h2">News</h2>
      <a href="/news" class="text-sm font-semibold">All news →</a>
    </div>
    <p class="mb-5 text-slate-700">{welcome.news_preview_title}</p>
    <div class="grid gap-4 md:grid-cols-3">
      {news.map((post) => (
        <article class="card">
          <p class="text-xs text-slate-500">{post.data.date.toISOString().slice(0, 10)}</p>
          <h3 class="mt-2 text-lg font-semibold"><a href={`/news/${post.id.replace('.md', '')}`}>{post.data.title}</a></h3>
          <p class="mt-2 text-sm text-slate-700">{post.data.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section pt-0 grid gap-6 md:grid-cols-2">
    <article class="card">
      <h2 class="h2 text-2xl">Join Us</h2>
      <p class="mt-3 text-slate-700">We recruit trainees and staff who are excited to work across autoimmunity, functional genomics, and translational receptor engineering.</p>
      <a href="/join" class="mt-4 btn-primary">View opportunities</a>
    </article>
    <article class="card">
      <h2 class="h2 text-2xl">Contact</h2>
      <p class="mt-3 text-slate-700">Email us at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <p class="mt-2 text-slate-700">{site.address}</p>
      <a href="/contact" class="mt-4 btn-secondary">Get in touch</a>
    </article>
  </section>

  <section class="section pt-0">
    <h2 class="h2">Funding</h2>
    <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {site.funding_logos.map((logo) => (
        <a href={logo.url ?? '#'} class="card flex h-20 items-center justify-center p-2" aria-label={logo.name}>
          <img src={logo.image} alt={logo.alt_text} loading="lazy" class="max-h-14" />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
