---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import site from '../data/site-settings.json';
import welcome from '../data/welcome.json';
import research from '../data/research-page.json';

const team = (await getCollection('team'))
  .filter((m) => m.data.featured_on_home)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const labPhoto = (welcome as any).lab_photo as string | undefined;

// Accent colors per research card (cycling)
const cardAccents = ['var(--color-accent)', 'var(--color-primary)', 'var(--color-navy)'];
---
<BaseLayout title="Welcome" description={site.mission_statement}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="relative flex items-center overflow-hidden" style="min-height: 520px;">
    {labPhoto ? (
      <>
        <img
          src={labPhoto}
          alt="Kohlgruber Lab"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0" style="background: linear-gradient(105deg, rgba(31,53,82,0.90) 0%, rgba(6,148,142,0.55) 62%, rgba(6,148,142,0.12) 100%);"></div>
      </>
    ) : (
      <div class="absolute inset-0" style="background: linear-gradient(135deg, #1F3552 0%, #06948E 100%);"></div>
    )}

    <div class="relative z-10 mx-auto w-full max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em]" style="color: rgba(231,135,43,0.95);">
        {welcome.hero.eyebrow}
      </p>
      <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-[3.25rem] leading-tight">
        {welcome.hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed" style="color: rgba(255,255,255,0.82);">
        {site.mission_statement}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="/research">Explore Research</a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-full border px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
          style="border-color: rgba(255,255,255,0.45);"
        >Contact Us</a>
      </div>
    </div>
  </section>

  <!-- ── Research Themes ───────────────────────────────────────── -->
  <section class="section">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="h2">Research</h2>
      <a href="/research" class="text-sm font-semibold text-brand-ink hover:text-brand-turquoise">
        Full overview →
      </a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {research.themes.map((theme, i) => (
        <a
          href="/research"
          class="research-home-card group relative block aspect-square overflow-hidden rounded-2xl no-underline"
          style={`background-color: ${i === 1 ? 'var(--color-soft-surface)' : i === 2 ? '#eef1f5' : '#f0f9f8'};`}
        >
          {(theme as any).image && (
            <img
              src={(theme as any).image}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 h-full w-full object-cover opacity-25 transition-opacity duration-300 group-hover:opacity-35"
            />
          )}
          <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center">
            <div
              class="mb-3 h-1 w-10 rounded-full"
              style={`background-color: ${cardAccents[i % cardAccents.length]};`}
            ></div>
            <h3
              class="text-lg font-bold leading-snug sm:text-xl"
              style={`color: ${cardAccents[i % cardAccents.length]};`}
            >
              {theme.title}
            </h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Featured Team Members ─────────────────────────────────── -->
  {team.length > 0 && (
    <section class="section pt-0">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="h2">Our Team</h2>
        <a href="/team" class="text-sm font-semibold text-brand-ink hover:text-brand-turquoise">
          Meet everyone →
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((member) => (
          <article class="card flex gap-4 p-5">
            <img
              src={member.data.photo}
              alt={`Portrait of ${member.data.name}`}
              class="h-20 w-20 shrink-0 rounded-xl object-cover"
              loading="lazy"
            />
            <div class="min-w-0">
              <h3 class="text-base font-semibold text-brand-ink">{member.data.name}</h3>
              <p class="text-sm font-medium" style="color: var(--color-primary);">{member.data.position}</p>
              {(member.data as any).short_bio && (
                <p class="mt-1 text-xs leading-5 text-brand-gray line-clamp-3">{(member.data as any).short_bio}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- ── News ─────────────────────────────────────────────────── -->
  {news.length > 0 && (
    <section class="section pt-0">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="h2">Latest News</h2>
        <a href="/news" class="text-sm font-semibold text-brand-ink hover:text-brand-turquoise">
          All news →
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {news.map((post) => (
          <article class="card">
            <p class="text-xs text-brand-gray">{post.data.date.toISOString().slice(0, 10)}</p>
            <h3 class="mt-2 text-base font-semibold text-brand-ink">
              <a href={`/news/${post.id.replace('.md', '')}`} class="hover:text-brand-turquoise">
                {post.data.title}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-6 text-brand-gray">{post.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- ── Funding ───────────────────────────────────────────────── -->
  {site.funding_logos.length > 0 && (
    <section class="section pt-0">
      <h2 class="h2 mb-5">Funding</h2>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {site.funding_logos.map((logo) => (
          <a
            href={logo.url ?? '#'}
            class="card flex h-20 items-center justify-center p-2"
            aria-label={logo.name}
          >
            <img src={logo.image} alt={logo.alt_text} loading="lazy" class="max-h-14 object-contain" />
          </a>
        ))}
      </div>
    </section>
  )}

</BaseLayout>
