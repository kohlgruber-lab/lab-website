---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import alumni from '../data/alumni.json';

// ── Sorting helpers ───────────────────────────────────────────────
const POSITION_RANK: [string, number][] = [
  ['principal investigator', 0],
  ['postdoctoral', 1],
  ['postdoc', 1],
  ['graduate student', 2],
  ['phd student', 2],
  ["master's", 3],
  ['masters student', 3],
  ['research assistant', 4],
  ['undergraduate', 5],
  ['undergrad', 5],
];

function positionRank(pos: string): number {
  const lower = pos.toLowerCase();
  for (const [key, rank] of POSITION_RANK) {
    if (lower.includes(key)) return rank;
  }
  return 6;
}

function lastName(name: string): string {
  const parts = name.trim().split(/\s+/);
  return parts[parts.length - 1].toLowerCase();
}

const allMembers = (await getCollection('team')).sort((a, b) => {
  const rankDiff = positionRank(a.data.position) - positionRank(b.data.position);
  if (rankDiff !== 0) return rankDiff;
  return lastName(a.data.name).localeCompare(lastName(b.data.name));
});

const pi = allMembers.filter((m) => positionRank(m.data.position) === 0);
const labMembers = allMembers.filter((m) => positionRank(m.data.position) !== 0);

// Convert a single flag emoji (e.g. 🇮🇳) to ISO 3166-1 alpha-2 code (e.g. "in") for flagcdn.com
function flagEmojiToIsoCode(emoji: string): string {
  if (!emoji) return '';
  return [...emoji]
    .map(c => { const cp = c.codePointAt(0)!; return (cp >= 0x1F1E6 && cp <= 0x1F1FF) ? String.fromCharCode(cp - 0x1F1E6 + 65) : ''; })
    .join('')
    .toLowerCase();
}

// Extract all flag emojis from a string that may contain multiple flags (e.g. "🇺🇸 & 🇨🇦")
function parseFlagEmojis(flagStr: string): string[] {
  if (!flagStr) return [];
  const chars = [...flagStr];
  const flags: string[] = [];
  for (let i = 0; i < chars.length - 1; i++) {
    const cp1 = chars[i].codePointAt(0)!;
    const cp2 = chars[i + 1].codePointAt(0)!;
    if (cp1 >= 0x1F1E6 && cp1 <= 0x1F1FF && cp2 >= 0x1F1E6 && cp2 <= 0x1F1FF) {
      flags.push(chars[i] + chars[i + 1]);
      i++;
    }
  }
  return flags;
}
---
<BaseLayout title="Team" description="Meet the Kohlgruber Lab team.">
  <section class="section">

    <h1 class="text-4xl font-semibold tracking-tight text-brand-ink">Team</h1>
    <p class="mt-3 max-w-3xl leading-7 text-brand-gray">
      Our team brings together clinical insight, molecular immunology, and computational analysis
      to tackle high-impact translational questions.
    </p>

    <!-- ── Principal Investigator ───────────────────────────────── -->
    {pi.map((m) => (
      <div class="pi-card mt-10">
        <img
          src={m.data.photo}
          alt={`Portrait of ${m.data.name}`}
          loading="lazy"
          class="pi-card-image"
        />
        <div class="pi-card-content">
          <p class="pi-card-kicker">Principal Investigator</p>
          <h2 class="pi-card-name flex items-center flex-wrap">
            <span>{m.data.name}{positionRank(m.data.position) <= 1 ? ', PhD' : ''}</span>
            {(m.data as any).nationality_flag_emoji && (
              <span style="margin-left: 0.75rem; display: inline-flex; align-items: center; gap: 4px;">
                {parseFlagEmojis((m.data as any).nationality_flag_emoji).map((flag) => (
                  <img
                    src={`https://flagcdn.com/w40/${flagEmojiToIsoCode(flag)}.png`}
                    alt={(m.data as any).nationality_country ?? ''}
                    title={(m.data as any).nationality_country ?? ''}
                    style="width: 28px; height: 18px; object-fit: cover; border-radius: 2px;"
                    loading="lazy"
                  />
                ))}
              </span>
            )}
          </h2>
          {(m.data as any).email && (
            <a href={`mailto:${(m.data as any).email}`} class="team-card-email mb-3 block">
              {(m.data as any).email}
            </a>
          )}
          {m.data.bio && m.data.bio !== 'TBD' && (
            <p class="pi-card-bio">{m.data.bio}</p>
          )}
          {m.data.fun_fact && (
            <p class="pi-card-fun-fact">
              <span class="font-semibold text-brand-ink">Outside the lab: </span>{m.data.fun_fact}
            </p>
          )}
        </div>
      </div>
    ))}

    <!-- ── Lab Members ──────────────────────────────────────────── -->
    {labMembers.length > 0 && (
      <div class="mt-12">
        <div class="team-grid-3">
          {labMembers.map((m) => (
            <article class="trainee-card">
              <!-- Photo fills top half -->
              <div class="trainee-card-photo-wrap">
                <img
                  src={m.data.photo}
                  alt={`Portrait of ${m.data.name}`}
                  loading="lazy"
                  class="trainee-card-photo"
                />
              </div>

              <!-- Front info -->
              <div class="trainee-card-front">
                <div class="trainee-card-front-text">
                  <h3 class="trainee-card-name">{m.data.name}{positionRank(m.data.position) <= 1 ? ', PhD' : ''}</h3>
                  <p class="trainee-card-position">{m.data.position}</p>
                  {(m.data as any).email && (
                    <a href={`mailto:${(m.data as any).email}`} class="team-card-email trainee-card-email-link">
                      {(m.data as any).email}
                    </a>
                  )}
                  {(m.data as any).research_project && (m.data as any).research_project !== 'TBD' && (
                    <p class="trainee-card-project">
                      <span class="trainee-card-project-label">Project: </span>
                      {(m.data as any).research_project}
                    </p>
                  )}
                </div>
                {(m.data as any).nationality_flag_emoji && (
                  <div class="flex flex-col gap-1 shrink-0 mt-0.5">
                    {parseFlagEmojis((m.data as any).nationality_flag_emoji).map((flag) => (
                      <img
                        src={`https://flagcdn.com/w80/${flagEmojiToIsoCode(flag)}.png`}
                        alt={(m.data as any).nationality_country ?? ''}
                        title={(m.data as any).nationality_country ?? ''}
                        style="width: 28px; height: 18px; object-fit: cover; border-radius: 2px;"
                        loading="lazy"
                      />
                    ))}
                  </div>
                )}
              </div>

              <!-- Hover overlay — shows bio -->
              <div class="trainee-card-overlay">
                <div class="mb-1 flex items-center gap-1.5">
                  <h3 class="trainee-card-overlay-name">{m.data.name}</h3>
                  {(m.data as any).nationality_flag_emoji && parseFlagEmojis((m.data as any).nationality_flag_emoji).map((flag) => (
                    <img
                      src={`https://flagcdn.com/w40/${flagEmojiToIsoCode(flag)}.png`}
                      alt={(m.data as any).nationality_country ?? ''}
                      style="width: 22px; height: 14px; object-fit: cover; border-radius: 2px;"
                      loading="lazy"
                    />
                  ))}
                </div>
                <p class="trainee-card-overlay-position">{m.data.position}</p>
                {m.data.bio && m.data.bio !== 'TBD' ? (
                  <p class="trainee-card-overlay-bio">{m.data.bio}</p>
                ) : (m.data as any).short_bio && (m.data as any).short_bio !== 'TBD' ? (
                  <p class="trainee-card-overlay-bio">{(m.data as any).short_bio}</p>
                ) : null}
              </div>
            </article>
          ))}
        </div>
      </div>
    )}

    <!-- ── Alumni ───────────────────────────────────────────────── -->
    {alumni.alumni.length > 0 && (
      <div class="mt-16">
        <h2 class="group-heading">Alumni</h2>
        <p class="mt-2 mb-6 text-brand-gray">
          We are proud of all our past trainees and the paths they have taken.
        </p>
        <div class="overflow-hidden rounded-2xl border bg-white shadow-soft" style="border-color: var(--color-border);">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b" style="border-color: var(--color-border); background-color: var(--color-soft-surface);">
                <th class="px-6 py-3 text-left font-semibold text-brand-ink">Name</th>
                <th class="px-6 py-3 text-left font-semibold text-brand-ink">Position Held</th>
                <th class="px-6 py-3 text-left font-semibold text-brand-ink">Currently</th>
              </tr>
            </thead>
            <tbody>
              {alumni.alumni.map((person, i) => (
                <tr
                  class="border-b last:border-0"
                  style={`border-color: var(--color-border);${i % 2 !== 0 ? ' background-color: var(--color-soft-surface);' : ''}`}
                >
                  <td class="px-6 py-4 font-medium text-brand-ink">{person.name}</td>
                  <td class="px-6 py-4 text-brand-gray">{person.position}</td>
                  <td class="px-6 py-4 text-brand-gray">{person.current}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

  </section>
</BaseLayout>
