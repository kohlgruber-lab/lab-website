---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Team" description="Meet the Kohlgruber Lab team.">
  <section class="section">
    <h1 class="text-4xl font-semibold tracking-tight text-brand-ink">Team</h1>
    <p class="mt-3 max-w-3xl text-brand-gray">
      Our team brings together clinical insight, molecular immunology, and computational analysis to tackle high-impact translational questions.
    </p>

    <div class="team-grid mt-8">
      {team.map((m) => (
        <article class="team-card">
          <div class="team-card-image-wrap">
            <img
              src={m.data.photo}
              alt={`Portrait of ${m.data.name}`}
              loading="lazy"
              class="team-card-image"
            />
          </div>

          <div class="team-card-content">
            <h2 class="team-card-name">{m.data.name}</h2>
            <p class="team-card-position">{m.data.position}</p>

            {m.data.email && (
              <a href={`mailto:${m.data.email}`} class="team-card-email">
                {m.data.email}
              </a>
            )}

            {(m.data.nationality_flag_emoji || m.data.nationality_country) && (
              <p class="team-card-nationality">
                {m.data.nationality_flag_emoji} {m.data.nationality_country}
              </p>
            )}

            {m.data.short_bio && (
              <p class="team-card-short-bio">{m.data.short_bio}</p>
            )}

            {m.data.fun_fact && (
              <p class="team-card-fun-fact">
                <span class="team-card-fun-fact-label">Fun fact:</span> {m.data.fun_fact}
              </p>
            )}
          </div>

          <div class="team-card-overlay">
            <h3 class="team-card-overlay-name">{m.data.name}</h3>
            <p class="team-card-overlay-position">{m.data.position}</p>

            {m.data.bio && (
              <p class="team-card-overlay-bio">{m.data.bio}</p>
            )}

            {m.data.places_lived && m.data.places_lived.length > 0 && (
              <p class="team-card-overlay-meta">
                <span class="team-card-overlay-label">Places I’ve lived:</span>{' '}
                {m.data.places_lived.join(', ')}
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
