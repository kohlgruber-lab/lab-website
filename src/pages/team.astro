---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Team" description="Meet the Kohlgruber Lab team.">
  <section class="section">
    <h1 class="text-4xl font-semibold tracking-tight">Team</h1>
    <p class="mt-3 max-w-3xl text-slate-700">Our team brings together clinical insight, molecular immunology, and computational analysis to tackle high-impact translational questions.</p>
    <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {team.map((m) => (
        <article class="card">
          <img src={m.data.photo} alt={`Portrait of ${m.data.name}`} loading="lazy" class="h-56 w-full rounded-xl object-cover" />
          <h2 class="mt-4 text-xl font-semibold">{m.data.name}</h2>
          <p class="text-slate-600">{m.data.position}</p>
          <p class="text-sm">{m.data.nationality_flag_emoji} {m.data.nationality_country}</p>
          <p class="mt-2 text-sm"><span class="font-medium">Places I’ve lived:</span> {m.data.places_lived.join(', ')}</p>
          <p class="mt-3 text-sm text-slate-700">{m.data.bio}</p>
          <p class="mt-3 rounded-xl bg-brand-orange/10 p-3 text-sm"><span class="font-medium">Fun fact:</span> {m.data.fun_fact}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
