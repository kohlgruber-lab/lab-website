---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import site from '../data/site-settings.json';
import { contactContent as contact } from '../lib/labWebsiteV2';
---
<BaseLayout title="Contact" description="Get in touch with the Kohlgruber Lab.">
  <section class="section">
    <h1 class="text-4xl font-semibold tracking-tight">{contact.title}</h1>
    <p class="mt-3 max-w-3xl text-slate-700">{contact.intro}</p>
    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <article class="card">
        <h2 class="text-xl font-semibold">Lab details</h2>
        <p class="mt-3">Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="mt-2">{site.address}</p>
        <p class="mt-4 text-sm text-slate-600">{contact.map_note}</p>
      </article>
      <ContactForm includeCollab={true} />
    </div>
  </section>
</BaseLayout>
