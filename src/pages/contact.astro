---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import site from '../data/site-settings.json';
import contact from '../data/contact-page.json';
---
<BaseLayout title={contact.title ?? 'Contact'} description="Get in touch with the Kohlgruber Lab.">
  <section class="section">
    <h1 class="text-4xl font-semibold tracking-tight text-brand-ink">
      {contact.title ?? 'Contact'}
    </h1>

    {contact.intro && (
      <p class="mt-3 max-w-3xl text-brand-gray">
        {contact.intro}
      </p>
    )}

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <article class="card">
        <h2 class="text-xl font-semibold text-brand-ink">Lab details</h2>
        <p class="mt-3 text-brand-ink">
          Email: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="mt-2 text-brand-gray">{site.address}</p>
        {contact.map_note && (
          <p class="mt-4 text-sm text-brand-gray">{contact.map_note}</p>
        )}
        {contact.location_description && (
          <p class="mt-4 leading-7 text-brand-gray">{contact.location_description}</p>
        )}
      </article>

      <ContactForm includeCollab={true} />
    </div>

    {(contact.lab_photo || contact.building_photo) && (
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {contact.lab_photo && (
          <article class="card p-4">
            <img
              src={contact.lab_photo}
              alt={contact.lab_photo_alt ?? 'Lab photo'}
              loading="lazy"
              class="h-72 w-full rounded-xl object-cover"
            />
          </article>
        )}

        {contact.building_photo && (
          <article class="card p-4">
            <img
              src={contact.building_photo}
              alt={contact.building_photo_alt ?? 'Building photo'}
              loading="lazy"
              class="h-72 w-full rounded-xl object-cover"
            />
          </article>
        )}
      </div>
    )}

    {contact.application_title && (
      <div class="mt-12">
        <h2 class="h2">{contact.application_title}</h2>

        {contact.application_intro && (
          <p class="mt-4 max-w-4xl leading-7 text-brand-gray">
            {contact.application_intro}
          </p>
        )}

        {contact.application_paths && contact.application_paths.length > 0 && (
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {contact.application_paths.map((path) => (
              <article class="card">
                <h3 class="text-lg font-semibold text-brand-ink">{path.type}</h3>
                <p class="mt-3 leading-7 text-brand-gray">{path.instructions}</p>
              </article>
            ))}
          </div>
        )}
      </div>
    )}
  </section>
</BaseLayout>
