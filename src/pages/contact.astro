---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import site from '../data/site-settings.json';
---
<BaseLayout title="Contact" description="Get in touch with the Kohlgruber Lab.">
  <section class="section">
    <h1 class="text-3xl font-bold">Contact</h1>
    <p class="mt-3">Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
    <p>{site.address}</p>
    <div class="mt-3 flex gap-3">{site.socials.map((social)=><a href={social.url}>{social.label}</a>)}</div>
    <div class="mt-8 max-w-2xl"><ContactForm includeCollab={true} /></div>
  </section>
</BaseLayout>
